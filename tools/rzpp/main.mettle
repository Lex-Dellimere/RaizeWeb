// tools/rzpp — the html"""...""" preprocessor (until the compiler has tagged
// literals; see docs/design/views.md §5).
//
//   rzpp <entry.mettle> [out.mettle]
//
// Entry mode (entry.mettle): the entry and every local import holding decorators or
// html""" literals each become <name>.gen.mettle (the entry's goes to `out` when given),
// with `import "x";` rewritten to `import "x.gen";` on the same line. Each file is
// turned from Mettle with view literals into plain Mettle:
//
//   * each `return html"""...""";` becomes the statements that build the
//     view's RzHtml tree, joined onto the literal's first line and followed
//     by as many newlines as the literal spanned, so every line after it
//     keeps its number and compiler errors point at the real source line
//   * every enum whose name ends in Msg gets NameMsg__put / NameMsg__decode
//   * rz decorators (@resource and its attribute/action decorators, @signal) are
//     blanked out in place and their structs get generated code (deco.mettle)
//   * the statics arrays and generated functions are appended at the end
//
// Exit status 0 on success, 1 with "path:line: message" on stderr.

import "std/io";
import "std/mem";
import "raize_core/str/str";
import "src";
import "gen";
import "msg";
import "deco";
import "signal";
import "entry";

// "examples/todos/app.mettle" -> "todos_app"
fn rzpp_prefix(path: string) -> string {
  var b: RzBuf* = rz_buf_new();
  var slash: int64 = rz_str_rfind_byte(path, 47);
  var start: int64 = 0;
  if (slash > 0) {
    var prev: int64 = slash - 1;
    while (prev > 0 && path.chars[prev - 1] != 47) { prev = prev - 1; }
    start = prev;
  }
  var i: int64 = start;
  while (i < (int64)path.length) {
    var c: int32 = (int32)path.chars[i];
    if (c == 46) { break; }
    if (rzpp_ident_char(c)) { rz_buf_add_byte(b, c); } else { rz_buf_add_byte(b, 95); }
    i = i + 1;
  }
  return rz_buf_take(b);
}

// Compiles one literal src[a..b) (the text between the triple quotes) into
// `out` as a single line of statements ending in `return __rzN;`.
export fn rzpp_literal(g: RzppGen*, a: int64, b: int64, out: RzBuf*) {
  var s: int64 = a;
  var e: int64 = b;
  while (s < e && rz_char_is_space((int32)g->src.chars[s])) { s = s + 1; }
  while (e > s && rz_char_is_space((int32)g->src.chars[e - 1])) { e = e - 1; }
  var root: RzppNode* = rzpp_node_new(g);
  rzpp_parse(g, root, s, e);
  rzpp_emit_node(g, root, out);
  rz_buf_add(out, "return ");
  rzpp_var(out, root->id);
  rz_buf_add(out, ";");
  rzpp_node_free(root);
}

// Runs the whole file. Returns the generated source, or empty with g->err set.
export fn rzpp_file(g: RzppGen*) -> string {
  var tail: RzBuf* = rz_buf_new();
  rzpp_decorators(g, tail);     // strips rz decorators from g->src (same lines)
  if (g->signals > 0) { rzpp_signal_resources(g, tail); }
  var src: string = g->src;
  var out: RzBuf* = rz_buf_new_cap((int64)src.length * 2);
  rzpp_messages(g, tail);
  var copied: int64 = 0;
  var at: int64 = rz_str_find(src, "html\"\"\"");
  while (at >= 0 && !rzpp_failed(g)) {
    if (rzpp_in_comment(src, at)) {
      at = rz_str_find_from(src, "html\"\"\"", at + 7);
      continue;
    }
    // The literal must be the value of a return statement.
    var r: int64 = at;
    while (r > 0 && rz_char_is_space((int32)src.chars[r - 1])) { r = r - 1; }
    if (r < 6 || !rz_str_eq(rz_str_sub(src, r - 6, r), "return")) {
      rzpp_fail(g, at, "html\"\"\"...\"\"\" must be returned: `return html\"\"\"...\"\"\";`");
      break;
    }
    var body: int64 = at + 7;
    var close: int64 = rz_str_find_from(src, "\"\"\"", body);
    if (close < 0) { rzpp_fail(g, at, "html\"\"\" is never closed"); break; }
    var semi: int64 = close + 3;
    while (semi < (int64)src.length && rz_char_is_space((int32)src.chars[semi])) { semi = semi + 1; }
    if (semi >= (int64)src.length || src.chars[semi] != 59) { rzpp_fail(g, close, "expected `;` after the html literal"); break; }
    rz_buf_add(out, rz_str_sub(src, copied, r - 6));
    rzpp_literal(g, body, close, out);
    var k: int64 = r - 6;
    while (k <= semi) {
      if (src.chars[k] == 10) { rz_buf_add_byte(out, 10); }
      k = k + 1;
    }
    copied = semi + 1;
    at = rz_str_find_from(src, "html\"\"\"", copied);
  }
  if (rzpp_failed(g)) {
    rz_buf_free(out);
    rz_buf_free(tail);
    return rz_str_empty();
  }
  rz_buf_add(out, rz_str_from(src, copied));
  rz_buf_add(out, "\n// ---- generated by tools/rzpp: do not edit, edit the source above ----\n");
  rz_buf_add(out, rz_buf_str(g->consts));
  rz_buf_add(out, rz_buf_str(tail));
  rz_buf_free(tail);
  return rz_buf_take(out);
}

export fn rzpp_gen_new(src: string, path: string) -> RzppGen* {
  var g: RzppGen* = (RzppGen*)calloc(1, sizeof(RzppGen));
  g->src = src;
  g->path = path;
  g->prefix = rzpp_prefix(path);
  g->consts = rz_buf_new();
  g->err = rz_buf_new();
  g->enums = rz_strlist_new();
  g->variants = rz_strlist_new();
  g->owners = rz_strlist_new();
  g->resources = rz_strlist_new();
  return g;
}

// Generates every file of the project rooted at `entry`; the entry's output goes to
// `out` (empty: beside it). Returns the exit status.
fn rzpp_run(entry: string, out: string) -> int32 {
  var p: RzppProject* = rzpp_project_load(entry);
  if (p->err.length > 0) { println("{p->err}"); return 1; }
  for i in 0..p->paths->len {
    if (!p->need[i]) { continue; }
    var g: RzppGen* = rzpp_gen_new(p->srcs->items[i], p->paths->items[i]);
    defer free((rawptr)g);
    if (i == 0) { g->path = entry; }
    g->imported = i > 0;
    var gen: string = rzpp_file(g);
    if (rzpp_failed(g)) {
      println("{rz_buf_str(g->err)}");
      return 1;
    }
    var text: string = rzpp_rewrite_imports(p, i, gen);
    var dst: string = rzpp_gen_path(p->paths->items[i]);
    if (i == 0 && out.length > 0) { dst = out; }
    if (!rzpp_write(dst, text)) { println("rzpp: cannot write {dst}"); return 1; }
  }
  return 0;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc != 2 && argc != 3) {
    println("usage: rzpp <entry.mettle> [out.mettle]");
    return 2;
  }
  var out: string = rz_str_empty();
  if (argc == 3) { out = rz_str_from_c(argv[2]); }
  return rzpp_run(rz_str_from_c(argv[1]), out);
}
