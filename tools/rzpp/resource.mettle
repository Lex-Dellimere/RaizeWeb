// tools/rzpp/resource — `@resource` structs: checks, then the generated code interface.
//
// For `@resource @required(text) @max_length(text, 40) @create(text) @read @destroy
// @action(pin, note_set_pinned) struct Note { id: int64; text: string; pinned: bool; }`
// it appends (DECISIONS.md D1, D4):
//
//   struct NoteList                    the layout of RzRecords, typed
//   Note__def, Note__layer             the static definition, the JSON API's layer
//   Note__init_fields                  one `comptime for` over typeof(Note).fields
//   Note__change_pin                   typed wrapper around the change fn
//   note_resource()                    builds the definition once
//   note_create/read/get/count/destroy/pin   the code interface
//   Note__api_*, note_json_api         the derived JSON API
//
// Every diagnostic is "path:line: what — fix", on the decorator's or field's line.

import "std/mem";
import "raize_core/str/str";
import "src";
import "decl";
import "contract";

fn rzpp_field_list(d: RzppDecl*) -> string {
  var b: RzBuf* = rz_buf_new();
  for i in 0..d->fnames->len {
    if (i > 0) { rz_buf_add(b, ", "); }
    rz_buf_add(b, d->fnames->items[i]);
  }
  return rz_buf_take(b);
}

// Index of field `name`, or -1 after failing with the list of fields.
fn rzpp_field(g: RzppGen*, d: RzppDecl*, dc: RzppDeco*, name: string) -> int64 {
  var i: int64 = rzpp_list_index(d->fnames, name);
  if (i < 0) { rzpp_fail(g, dc->at, "@{dc->name}: `{name}` is not a field of {d->name} — use one of: {rzpp_field_list(d)}"); }
  return i;
}

fn rzpp_string_field(g: RzppGen*, d: RzppDecl*, dc: RzppDeco*, name: string) -> int64 {
  var i: int64 = rzpp_field(g, d, dc, name);
  if (i >= 0 && !rz_str_eq(d->ftypes->items[i], "string")) {
    rzpp_fail(g, dc->at, "@{dc->name}({name}): {d->name}.{name} is {d->ftypes->items[i]}, not string — @{dc->name} applies to string fields");
    return -1;
  }
  return i;
}

fn rzpp_nargs(g: RzppGen*, dc: RzppDeco*, n: int64, shape: string) -> bool {
  if (dc->args->len != n) { rzpp_fail(g, dc->at, "@{dc->name} takes {n} argument(s) — write {shape}"); return false; }
  return true;
}

fn rzpp_is_int(s: string) -> bool {
  if (s.length == 0) { return false; }
  for i in 0..s.length {
    if (!rz_char_is_digit((int32)s.chars[i])) { return false; }
  }
  return true;
}

fn rzpp_is_snake(s: string) -> bool {
  if (s.length == 0) { return false; }
  for i in 0..s.length {
    var c: int32 = (int32)s.chars[i];
    if (!((c >= 97 && c <= 122) || c == 95 || (i > 0 && rz_char_is_digit(c)))) { return false; }
  }
  return true;
}

// Fails when `fn name(` is already declared in the source (a generated name).
fn rzpp_free_name(g: RzppGen*, at: int64, name: string, why: string) -> bool {
  var decl: int64 = rz_str_find(g->src, "fn {name}(");
  if (decl < 0) { return true; }
  rzpp_fail(g, at, "{why} generates fn {name}, but line {rzpp_line_of(g->src, decl)} already declares it — rename that function");
  return false;
}

const RZPP_GENERATED: string = "resource json_api create read get count update destroy";
const RZPP_PARAMS: string = "dl id errs rec arena out app base";

fn rzpp_resource_fields(g: RzppGen*, d: RzppDecl*) -> bool {
  var T: string = d->name;
  var at: int64 = rzpp_list_index(d->fnames, "id");
  if (at < 0) {
    rzpp_fail(g, d->at, "@resource {T}: the first field must be `id: int64` (the primary key) — add it first");
    return false;
  }
  if (at > 0) {
    rzpp_fail(g, d->fat[at], "@resource {T}: `id` must be the first field — move `id: int64` above {d->fnames->items[0]}");
    return false;
  }
  if (!rz_str_eq(d->ftypes->items[0], "int64")) {
    rzpp_fail(g, d->fat[0], "@resource {T}: id is {d->ftypes->items[0]}, not int64 — write `id: int64`");
    return false;
  }
  for i in 0..d->fnames->len {
    var t: string = d->ftypes->items[i];
    if (!(rz_str_eq(t, "int32") || rz_str_eq(t, "int64") || rz_str_eq(t, "bool") || rz_str_eq(t, "string"))) {
      rzpp_fail(g, d->fat[i], "{T}.{d->fnames->items[i]}: type {t} is not supported by @resource — use int32, int64, bool or string");
      return false;
    }
  }
  return true;
}

fn rzpp_is_action(nm: string) -> bool {
  return rz_str_eq(nm, "create") || rz_str_eq(nm, "read") || rz_str_eq(nm, "update") || rz_str_eq(nm, "destroy") || rz_str_eq(nm, "action");
}

// The accept mask of @create(...) / @update(...); -1 after failing.
fn rzpp_accept(g: RzppGen*, d: RzppDecl*, dc: RzppDeco*) -> int64 {
  var params: RzStrList* = rz_str_split(RZPP_PARAMS, 32);
  var mask: int64 = 0;
  for k in 0..dc->args->len {
    var name: string = dc->args->items[k];
    var f: int64 = rzpp_field(g, d, dc, name);
    if (f < 0) { mask = -1; break; }
    if (f == 0) { rzpp_fail(g, dc->at, "@{dc->name}: `id` is assigned by the data layer — remove it from the list"); mask = -1; break; }
    if (rzpp_list_index(params, name) >= 0) { rzpp_fail(g, dc->at, "@{dc->name}: field `{name}` clashes with a parameter of the generated {d->snake}_{dc->name} — rename the field"); mask = -1; break; }
    mask = mask | ((int64)1 << f);
  }
  rz_strlist_free(params);
  return mask;
}

fn rzpp_length_deco(g: RzppGen*, d: RzppDecl*, dc: RzppDeco*, body: RzBuf*, def: string) -> bool {
  if (!rzpp_nargs(g, dc, 2, "@{dc->name}(field, n)")) { return false; }
  var j: int64 = rzpp_string_field(g, d, dc, dc->args->items[0]);
  if (j < 0) { return false; }
  if (!rzpp_is_int(dc->args->items[1])) { rzpp_fail(g, dc->at, "@{dc->name}: `{dc->args->items[1]}` is not a byte count — write an integer >= 0"); return false; }
  rz_buf_add(body, "  rz__attr_{dc->name}({def}, {j}, {dc->args->items[1]});\n");
  return true;
}

// The custom action @action(name, change_fn): checks, then the rz__action_custom line.
fn rzpp_custom_deco(g: RzppGen*, d: RzppDecl*, dc: RzppDeco*, body: RzBuf*, def: string) -> bool {
  if (!rzpp_nargs(g, dc, 2, "@action(name, change_fn)")) { return false; }
  var an: string = dc->args->items[0];
  var cf: string = dc->args->items[1];
  if (!rzpp_is_snake(an)) { rzpp_fail(g, dc->at, "@action: `{an}` is not a snake_case name — write e.g. @action(mark_done, {cf})"); return false; }
  var reserved: RzStrList* = rz_str_split(RZPP_GENERATED, 32);
  var clash: bool = rzpp_list_index(reserved, an) >= 0;
  rz_strlist_free(reserved);
  if (clash) { rzpp_fail(g, dc->at, "@action({an}, ...): {d->snake}_{an} is generated by raize already — pick another action name"); return false; }
  var sig: int64 = rz_str_find(g->src, "fn {cf}(");
  var typed: bool = sig >= 0;
  if (typed) {
    var close: int64 = rz_str_find_byte_from(g->src, 41, sig);
    typed = close > sig && rz_str_contains(rz_str_sub(g->src, sig, close), "{d->name}*");
  }
  if (!typed) {
    rzpp_fail(g, dc->at, "@action({an}, {cf}): no `fn {cf}(r: {d->name}*)` in this file — add it; it edits fields of r and calls nothing in raize");
    return false;
  }
  if (!rzpp_free_name(g, dc->at, "{d->snake}_{an}", "@action({an}, {cf})")) { return false; }
  rz_buf_add(body, "  rz__action_custom({def}, \"{an}\", &{d->name}__change_{an});\n");
  return true;
}

// Emits the statement that records decorator `dc` in note_resource(); false on error.
fn rzpp_resource_deco(g: RzppGen*, d: RzppDecl*, dc: RzppDeco*, body: RzBuf*, actions: RzStrList*) -> bool {
  var nm: string = dc->name;
  var def: string = "&{d->name}__def";
  if (rzpp_is_action(nm)) {
    var key: string = nm;
    if (rz_str_eq(nm, "action") && dc->args->len > 0) { key = dc->args->items[0]; }
    if (rzpp_list_index(actions, key) >= 0) {
      rzpp_fail(g, dc->at, "action {key} is declared twice on {d->name} — keep one");
      return false;
    }
    rz_strlist_push(actions, key);
  }
  if (rz_str_eq(nm, "resource") || rz_str_eq(nm, "read") || rz_str_eq(nm, "destroy")) {
    if (!rzpp_nargs(g, dc, 0, "@{nm}")) { return false; }
    if (!rz_str_eq(nm, "resource")) { rz_buf_add(body, "  rz__action_{nm}({def});\n"); }
  } else if (rz_str_eq(nm, "required")) {
    if (!rzpp_nargs(g, dc, 1, "@required(field)")) { return false; }
    var i: int64 = rzpp_string_field(g, d, dc, dc->args->items[0]);
    if (i < 0) { return false; }
    rz_buf_add(body, "  rz__attr_required({def}, {i});\n");
  } else if (rz_str_eq(nm, "min_length") || rz_str_eq(nm, "max_length")) {
    return rzpp_length_deco(g, d, dc, body, def);
  } else if (rz_str_eq(nm, "create") || rz_str_eq(nm, "update")) {
    var mask: int64 = rzpp_accept(g, d, dc);
    if (mask < 0) { return false; }
    rz_buf_add(body, "  rz__action_{nm}({def}, {mask});\n");
  } else if (rz_str_eq(nm, "action")) {
    return rzpp_custom_deco(g, d, dc, body, def);
  } else {
    rzpp_fail(g, dc->at, "@{nm} is not a resource decorator — use @required, @min_length, @max_length, @create, @read, @update, @destroy or @action");
    return false;
  }
  return true;
}

const RZPP_THREAD: string = "any (the data layer serializes access)";
const RZPP_DL: string = "the data layer (rz_mem_layer(app, ..., n) or another layer for this resource)";
const RZPP_ERRS: string = "receives the status and per-field messages; may be 0; reset on entry";
const RZPP_LAYER_E: string = "RZ_E_DATA_LAYER or RZ_E_CONFLICT from layers other than memory";

// The typed parameters, record assignments and example arguments of an accept list.
struct RzppAccept {
  params: RzBuf*;    // ", title: string, done: bool"
  sets: RzBuf*;      // "  rec.title = title;\n"
  sample: RzBuf*;    // ", \"text\", true"
}

fn rzpp_accept_parts(d: RzppDecl*, dc: RzppDeco*, ins: RzBuf*, p: RzppAccept*) {
  p->params = rz_buf_new();
  p->sets = rz_buf_new();
  p->sample = rz_buf_new();
  for a in 0..dc->args->len {
    var f: string = dc->args->items[a];
    var t: string = d->ftypes->items[rzpp_list_index(d->fnames, f)];
    rz_buf_add(p->params, ", {f}: {t}");
    rz_buf_add(p->sets, "  rec.{f} = {f};\n");
    rz_buf_add(p->sample, ", {rzpp_sample(t)}");
    if (rz_str_eq(t, "string")) { rzpp_in(ins, f, "{d->name}.{f}; borrowed, trimmed, then copied by the layer"); }
    else { rzpp_in(ins, f, "{d->name}.{f}"); }
  }
}

fn rzpp_accept_free(p: RzppAccept*) {
  rz_buf_free(p->params);
  rz_buf_free(p->sets);
  rz_buf_free(p->sample);
}

fn rzpp_emit_create(d: RzppDecl*, dc: RzppDeco*, out: RzBuf*, ex: string) {
  var T: string = d->name;
  var s: string = d->snake;
  var ins: RzBuf* = rz_buf_new();
  rzpp_in(ins, "dl", RZPP_DL);
  var p: RzppAccept;
  rzpp_accept_parts(d, dc, ins, &p);
  rzpp_in(ins, "id", "receives the new id; may be 0");
  rzpp_in(ins, "errs", RZPP_ERRS);
  rzpp_contract(out, "Creates a {T} from the accepted fields (strings trimmed, then validated); the other fields are zero.", ins,
    "RZ_OK; RZ_E_INVALID (messages in errs); RZ_E_FULL; RZ_E_NOMEM; RZ_E_USAGE when dl is 0 or stores another resource; {RZPP_LAYER_E}",
    "nothing kept: strings are borrowed for the call and the layer copies them", RZPP_THREAD,
    "var id: int64 = 0;\nvar errs: RzErrors;\nvar rc: int32 = {s}_create(dl{rz_buf_str(p.sample)}, &id, &errs);");
  rz_buf_add(out, "{ex}fn {s}_create(dl: RzDataLayer*{rz_buf_str(p.params)}, id: int64*, errs: RzErrors*) -> int32 {{\n  var rec: {T};\n  memset((rawptr)&rec, 0, (int64)sizeof({T}));\n{rz_buf_str(p.sets)}  return rz__create(dl, {s}_resource(), (rawptr)&rec, id, errs);\n}\n");
  rzpp_accept_free(&p);
}

fn rzpp_emit_update(d: RzppDecl*, dc: RzppDeco*, mask: int64, out: RzBuf*, ex: string) {
  var T: string = d->name;
  var s: string = d->snake;
  var ins: RzBuf* = rz_buf_new();
  rzpp_in(ins, "dl", RZPP_DL);
  rzpp_in(ins, "id", "the {T} to change");
  var p: RzppAccept;
  rzpp_accept_parts(d, dc, ins, &p);
  rzpp_in(ins, "errs", RZPP_ERRS);
  rzpp_contract(out, "Sets every accepted field of the {T} with this id (strings trimmed), validates the whole record and stores it atomically; unaccepted fields keep their values.", ins,
    "RZ_OK; RZ_E_NOT_FOUND; RZ_E_INVALID (messages in errs; nothing stored); RZ_E_NOMEM; RZ_E_USAGE when dl is 0 or stores another resource; {RZPP_LAYER_E}",
    "nothing kept: strings are borrowed for the call and the layer copies them", RZPP_THREAD,
    "var errs: RzErrors;\nvar rc: int32 = {s}_update(dl, id{rz_buf_str(p.sample)}, &errs);");
  rz_buf_add(out, "{ex}fn {s}_update(dl: RzDataLayer*, id: int64{rz_buf_str(p.params)}, errs: RzErrors*) -> int32 {{\n  var rec: {T};\n  memset((rawptr)&rec, 0, (int64)sizeof({T}));\n{rz_buf_str(p.sets)}  return rz__update(dl, {s}_resource(), id, (rawptr)&rec, {mask}, errs, (rawptr)0, (RzArena*)0);\n}\n");
  rzpp_accept_free(&p);
}

fn rzpp_emit_read(d: RzppDecl*, out: RzBuf*, ex: string) {
  var T: string = d->name;
  var s: string = d->snake;
  var ins: RzBuf* = rz_buf_new();
  rzpp_in(ins, "dl", RZPP_DL);
  rzpp_in(ins, "arena", "receives the records and their strings (ctx->arena in a handler)");
  rzpp_contract(out, "Every {T}, in id order, copied into `arena`.", ins,
    "the list; count 0 when there are none or on RZ_E_USAGE (dl is 0 or stores another resource), RZ_E_NOMEM (arena full) or a layer error",
    "the items and their strings belong to `arena`; nothing views the layer", RZPP_THREAD,
    "var list: {T}List = {s}_read(dl, ctx->arena);\nfor i in 0..list.count {{ var r: {T}* = &list.items[i]; }");
  rz_buf_add(out, "{ex}fn {s}_read(dl: RzDataLayer*, arena: RzArena*) -> {T}List {{\n  var recs: RzRecords;\n  rz__read(dl, {s}_resource(), &recs, arena);\n  var list: {T}List;\n  list.items = ({T}*)recs.items;\n  list.count = recs.count;\n  return list;\n}\n");
  ins = rz_buf_new();
  rzpp_in(ins, "dl", RZPP_DL);
  rzpp_in(ins, "id", "the {T} to load");
  rzpp_in(ins, "out", "receives the record");
  rzpp_in(ins, "arena", "receives its strings (ctx->arena in a handler)");
  rzpp_contract(out, "Loads the {T} with this id into `out`.", ins,
    "RZ_OK; RZ_E_NOT_FOUND; RZ_E_NOMEM (arena full); RZ_E_USAGE when dl is 0 or stores another resource; RZ_E_DATA_LAYER from other layers",
    "`out`'s strings belong to `arena` (on an error they are \"\")", RZPP_THREAD,
    "var r: {T};\nif ({s}_get(dl, 1, &r, ctx->arena) == RZ_OK) {{ }");
  rz_buf_add(out, "{ex}fn {s}_get(dl: RzDataLayer*, id: int64, out: {T}*, arena: RzArena*) -> int32 {{\n  return rz__get(dl, {s}_resource(), id, (rawptr)out, arena);\n}\n");
  ins = rz_buf_new();
  rzpp_in(ins, "dl", RZPP_DL);
  rzpp_contract(out, "Number of {T} records stored.", ins, "the count; 0 when dl is 0 or stores another resource (no RZ_E_* codes)",
    "nothing", RZPP_THREAD, "var n: int32 = {s}_count(dl);");
  rz_buf_add(out, "{ex}fn {s}_count(dl: RzDataLayer*) -> int32 {{\n  return rz__count(dl, {s}_resource());\n}\n");
}

fn rzpp_emit_destroy(d: RzppDecl*, out: RzBuf*, ex: string) {
  var T: string = d->name;
  var s: string = d->snake;
  var ins: RzBuf* = rz_buf_new();
  rzpp_in(ins, "dl", RZPP_DL);
  rzpp_in(ins, "id", "the {T} to remove");
  rzpp_in(ins, "errs", RZPP_ERRS);
  rzpp_contract(out, "Removes the {T} with this id.", ins,
    "RZ_OK; RZ_E_NOT_FOUND; RZ_E_USAGE when dl is 0 or stores another resource; RZ_E_DATA_LAYER from other layers",
    "nothing; the layer frees its copy", RZPP_THREAD, "var rc: int32 = {s}_destroy(dl, id, 0);");
  rz_buf_add(out, "{ex}fn {s}_destroy(dl: RzDataLayer*, id: int64, errs: RzErrors*) -> int32 {{\n  return rz__destroy(dl, {s}_resource(), id, errs);\n}\n");
}

fn rzpp_emit_custom(d: RzppDecl*, dc: RzppDeco*, out: RzBuf*, ex: string) {
  var T: string = d->name;
  var s: string = d->snake;
  var an: string = dc->args->items[0];
  var cf: string = dc->args->items[1];
  rzpp_glue(out, "Calls {cf} on the record inside the layer's modify.");
  rz_buf_add(out, "fn {T}__change_{an}(rec: rawptr) {{\n  {cf}(({T}*)rec);\n}\n");
  var ins: RzBuf* = rz_buf_new();
  rzpp_in(ins, "dl", RZPP_DL);
  rzpp_in(ins, "id", "the {T} to change");
  rzpp_in(ins, "errs", RZPP_ERRS);
  rzpp_contract(out, "Runs action {an}: loads the {T}, applies {cf}, validates and stores it atomically.", ins,
    "RZ_OK; RZ_E_NOT_FOUND; RZ_E_INVALID (messages in errs; nothing stored); RZ_E_NOMEM; RZ_E_USAGE when dl is 0 or stores another resource; RZ_E_DATA_LAYER from other layers",
    "nothing", "any; {cf} runs inside the layer's lock, so it must only edit fields",
    "var errs: RzErrors;\nvar rc: int32 = {s}_{an}(dl, id, &errs);");
  rz_buf_add(out, "{ex}fn {s}_{an}(dl: RzDataLayer*, id: int64, errs: RzErrors*) -> int32 {{\n  return rz__action(dl, {s}_resource(), \"{an}\", id, errs, (rawptr)0, (RzArena*)0);\n}\n");
}

fn rzpp_emit_interface(d: RzppDecl*, masks: int64*, out: RzBuf*, ex: string) {
  for k in 0..d->n {
    var dc: RzppDeco* = &d->decos[k];
    if (rz_str_eq(dc->name, "create")) { rzpp_emit_create(d, dc, out, ex); }
    else if (rz_str_eq(dc->name, "update")) { rzpp_emit_update(d, dc, masks[k], out, ex); }
    else if (rz_str_eq(dc->name, "read")) { rzpp_emit_read(d, out, ex); }
    else if (rz_str_eq(dc->name, "destroy")) { rzpp_emit_destroy(d, out, ex); }
    else if (rz_str_eq(dc->name, "action")) { rzpp_emit_custom(d, dc, out, ex); }
  }
}

fn rzpp_api_route(out: RzBuf*, routes: RzBuf*, T: string, what: string, call: string, verb: string, suffix: string) {
  rzpp_glue(out, "{verb} <base>{suffix}.");
  rz_buf_add(out, "fn {T}__api_{what}(ctx: RzContext*) -> int32 {{\n  return {call};\n}\n");
  rz_buf_add(routes, "  rz__app_route(app, \"{verb}\", base, \"{suffix}\", &{T}__api_{what});\n");
}

fn rzpp_emit_api(d: RzppDecl*, out: RzBuf*, ex: string) {
  var T: string = d->name;
  var s: string = d->snake;
  var routes: RzBuf* = rz_buf_new();
  var list: RzBuf* = rz_buf_new();
  for k in 0..d->n {
    var nm: string = d->decos[k].name;
    if (rz_str_eq(nm, "read")) {
      rzpp_api_route(out, routes, T, "list", "rz__api_list(ctx, {T}__layer)", "GET", "");
      rzpp_api_route(out, routes, T, "get", "rz__api_get(ctx, {T}__layer)", "GET", "/:id");
      rz_buf_add(list, " GET base, GET base/:id;");
    } else if (rz_str_eq(nm, "create")) {
      rzpp_api_route(out, routes, T, "create", "rz__api_create(ctx, {T}__layer)", "POST", "");
      rz_buf_add(list, " POST base;");
    } else if (rz_str_eq(nm, "update")) {
      rzpp_api_route(out, routes, T, "update", "rz__api_update(ctx, {T}__layer)", "PATCH", "/:id");
      rz_buf_add(list, " PATCH base/:id;");
    } else if (rz_str_eq(nm, "destroy")) {
      rzpp_api_route(out, routes, T, "destroy", "rz__api_destroy(ctx, {T}__layer)", "DELETE", "/:id");
      rz_buf_add(list, " DELETE base/:id;");
    } else if (rz_str_eq(nm, "action")) {
      var an: string = d->decos[k].args->items[0];
      rzpp_api_route(out, routes, T, an, "rz__api_action(ctx, {T}__layer, \"{an}\")", "POST", "/:id/{an}");
      rz_buf_add(list, " POST base/:id/{an};");
    }
  }
  var ins: RzBuf* = rz_buf_new();
  rzpp_in(ins, "app", "the app being declared (from rz_run)");
  rzpp_in(ins, "base", "the route prefix (\"/api/{s}s\"): starts with /, no trailing /; copied");
  rzpp_in(ins, "dl", "the data layer the routes use; must store {s}_resource()");
  rzpp_contract(out, "Mounts the JSON API of {T} under `base`:{rz_buf_str(list)} once per resource (DECISIONS.md D4 statuses).", ins,
    "nothing; a bad base, a missing or mismatched layer, or a second mount is reported by rz_run at startup",
    "the app keeps `dl` for its routes but does not free it (rz_mem_layer layers are app-owned)",
    "the declaration function only (main thread, before serving)",
    "{s}_json_api(app, \"/api/{s}s\", rz_mem_layer(app, {s}_resource(), 100));");
  rz_buf_add(out, "{ex}fn {s}_json_api(app: RzApp*, base: string, dl: RzDataLayer*) {{\n  if (rz__app_api(app, base, dl, {s}_resource()) != RZ_OK) {{ return; }\n  {T}__layer = dl;\n");
  rz_buf_add(out, rz_buf_str(routes));
  rz_buf_add(out, "}\n");
  rz_buf_free(routes);
  rz_buf_free(list);
}

fn rzpp_emit_head(d: RzppDecl*, body: RzBuf*, out: RzBuf*, ex: string) {
  var T: string = d->name;
  var s: string = d->snake;
  rz_buf_add(out, "\n// ---- @resource {T} ----\n/// The records returned by {s}_read, typed (the layout of RzRecords).\n");
  rz_buf_add(out, "{ex}struct {T}List {{\n  items: {T}*;   // count records back to back; owned by the arena passed to {s}_read\n  count: int32;  // number of records\n}\n");
  rzpp_glue(out, "The static definition of {T}.");
  rz_buf_add(out, "var {T}__def: RzResourceDef;\n");
  rzpp_glue(out, "The layer {s}_json_api mounted, read by the API handlers.");
  rz_buf_add(out, "var {T}__layer: RzDataLayer* = 0;\n");
  rzpp_glue(out, "Records every field of {T} as the compiler laid it out.");
  rz_buf_add(out, "fn {T}__init_fields(def: RzResourceDef*) {{\n  comptime for f in typeof({T}).fields {{\n    rz__resource_field(def, f.name, f.type.kind, (int64)f.offset, (int64)f.type.size);\n  }\n}\n");
  rzpp_contract(out, "The definition of resource {T}: fields, validations and actions. Built on the first call, static afterwards.", rz_buf_new(),
    "the static definition (never 0)", "nothing; never free it",
    "first call on the main thread during declaration; any thread afterwards",
    "var dl: RzDataLayer* = rz_mem_layer(app, {s}_resource(), 100);");
  rz_buf_add(out, "{ex}fn {s}_resource() -> RzResourceDef* {{\n  if (rz__resource_ready(&{T}__def)) {{ return &{T}__def; }\n  rz__resource_begin(&{T}__def, \"{s}\", \"{T}\", (int64)sizeof({T}));\n  {T}__init_fields(&{T}__def);\n{rz_buf_str(body)}  rz__resource_end(&{T}__def);\n  return &{T}__def;\n}\n");
}

// Checks one @resource struct and appends its generated code to `out`.
export fn rzpp_resource(g: RzppGen*, d: RzppDecl*, out: RzBuf*) {
  if (!rzpp_resource_fields(g, d)) { return; }
  var body: RzBuf* = rz_buf_new();
  var actions: RzStrList* = rz_strlist_new();
  var masks: int64[32];
  for k in 0..d->n {
    var dc: RzppDeco* = &d->decos[k];
    if (!rzpp_resource_deco(g, d, dc, body, actions)) { rz_buf_free(body); rz_strlist_free(actions); return; }
    masks[k] = 0;
    if (rz_str_eq(dc->name, "update")) { masks[k] = rzpp_accept(g, d, dc); }
  }
  var nact: int64 = (int64)actions->len;
  rz_strlist_free(actions);
  if (nact == 0) {
    rzpp_fail(g, d->decos[0].at, "@resource {d->name} declares no action — add @create(fields), @read, @update(fields), @destroy or @action(name, fn)");
    rz_buf_free(body);
    return;
  }
  var gen: RzStrList* = rz_str_split(RZPP_GENERATED, 32);
  for k in 0..gen->len {
    if (!rzpp_failed(g)) { rzpp_free_name(g, d->decos[0].at, "{d->snake}_{gen->items[k]}", "@resource {d->name}"); }
  }
  rz_strlist_free(gen);
  if (rzpp_failed(g)) { rz_buf_free(body); return; }
  var ex: string = "";
  if (d->exported) { ex = "export "; }
  rzpp_emit_head(d, body, out, ex);
  rzpp_emit_interface(d, &masks[0], out, ex);
  rzpp_emit_api(d, out, ex);
  rz_buf_free(body);
}
