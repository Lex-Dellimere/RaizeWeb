// raize/config tests — defaults, the exact RAIZE_* overlay, strict parsing,
// the pre-bind checks, freeze, and the server-opts mapping.
//
//   ./mettle-build/bin/mettle test tests/unit/config_test.mettle
//
// The environment and the filesystem are injected. The compile-time
// interpreter cannot call getenv/dir_exists (it stubs C functions), so the
// tests install a table-backed env provider and a boolean dir provider. The
// production providers are exercised by the native probe, not here.

import "std/mem";
import "../../framework/str/str";
import "../../framework/config/config";

// The config module owns the test tables (see env.mettle / validate.mettle):
// the interpreter cannot call getenv/dir_exists and drops string arguments
// across indirect calls, so tests populate a table through normal calls.
fn t_errs(e: RzConfigErrors*) {
  rz_config_errors_reset(e);
}

// ---------------------------------------------------------------------------
// Defaults
// ---------------------------------------------------------------------------

@test fn t_defaults() -> int32 {
  var c: RzConfig = rz_config_default();
  if (rz_config_port(&c) != 8080) { return 1; }
  if (rz_config_workers(&c) != 4) { return 2; }
  if (rz_config_max_body(&c) != 1048576) { return 3; }
  if (rz_config_max_header_bytes(&c) != 8192) { return 4; }
  if (rz_config_keepalive(&c) != 100) { return 5; }
  if (rz_config_read_timeout_ms(&c) != 10000) { return 6; }
  if (rz_config_cache_max_age(&c) != 60) { return 7; }
  if (!rz_str_eq(rz_config_bind(&c), "0.0.0.0")) { return 8; }
  if (!rz_str_eq(rz_config_static_root(&c), "public")) { return 9; }
  if (!rz_str_eq(rz_config_template_root(&c), "templates")) { return 10; }
  if (!rz_str_eq(rz_config_allow_origin(&c), "*")) { return 11; }
  if (!rz_str_eq(rz_config_store_dsn(&c), "")) { return 12; }
  if (!rz_str_eq(rz_config_env(&c), "dev")) { return 13; }
  if (rz_config_buf_cap(&c) != 16384) { return 14; }   // 8192 + 8192 slack
  if (rz_config_frozen(&c)) { return 15; }
  if (rz_config_validate_code(&c) != RZ_CFG_OK) { return 16; }
  return 0;
}

// ---------------------------------------------------------------------------
// Environment overlay
// ---------------------------------------------------------------------------

@test fn t_env_overlay() -> int32 {
  rz_config_env_test_begin();
  rz_config_env_test_set("RAIZE_PORT", "1234");
  rz_config_env_test_set("RAIZE_WORKERS", "2");
  rz_config_env_test_set("RAIZE_MAX_BODY_BYTES", "2048");
  var c: RzConfig = rz_config_default();
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_from_env(&c, &e) != 0) { return 1; }
  if (rz_config_error_count(&e) != 0) { return 2; }
  if (rz_config_port(&c) != 1234) { return 3; }
  if (rz_config_workers(&c) != 2) { return 4; }
  if (rz_config_max_body(&c) != 2048) { return 5; }
  // untouched fields keep their defaults
  if (rz_config_keepalive(&c) != 100) { return 6; }
  return 0;
}

@test fn t_env_all_names() -> int32 {
  rz_config_env_test_begin();
  rz_config_env_test_set("RAIZE_BIND_ADDR", "127.0.0.1");
  rz_config_env_test_set("RAIZE_PORT", "9000");
  rz_config_env_test_set("RAIZE_WORKERS", "8");
  rz_config_env_test_set("RAIZE_MAX_HEADER_BYTES", "4096");
  rz_config_env_test_set("RAIZE_MAX_BODY_BYTES", "4096");
  rz_config_env_test_set("RAIZE_KEEPALIVE_MAX", "7");
  rz_config_env_test_set("RAIZE_READ_TIMEOUT_MS", "250");
  rz_config_env_test_set("RAIZE_STATIC_ROOT", "www");
  rz_config_env_test_set("RAIZE_TEMPLATE_ROOT", "tpl");
  rz_config_env_test_set("RAIZE_CACHE_MAX_AGE", "0");
  rz_config_env_test_set("RAIZE_ALLOWED_ORIGIN", "https://example.test");
  rz_config_env_test_set("RAIZE_STORE_DSN", "mem://x");
  var c: RzConfig = rz_config_default();
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_from_env(&c, &e) != 0) { return 1; }
  if (!rz_str_eq(rz_config_bind(&c), "127.0.0.1")) { return 2; }
  if (rz_config_port(&c) != 9000) { return 3; }
  if (rz_config_workers(&c) != 8) { return 4; }
  if (rz_config_max_header_bytes(&c) != 4096) { return 5; }
  if (rz_config_max_body(&c) != 4096) { return 6; }
  if (rz_config_keepalive(&c) != 7) { return 7; }
  if (rz_config_read_timeout_ms(&c) != 250) { return 8; }
  if (!rz_str_eq(rz_config_static_root(&c), "www")) { return 9; }
  if (!rz_str_eq(rz_config_template_root(&c), "tpl")) { return 10; }
  if (rz_config_cache_max_age(&c) != 0) { return 11; }
  if (!rz_str_eq(rz_config_allow_origin(&c), "https://example.test")) { return 12; }
  if (!rz_str_eq(rz_config_store_dsn(&c), "mem://x")) { return 13; }
  return 0;
}

@test fn t_env_absent_keeps_defaults() -> int32 {
  rz_config_env_test_begin();   // provider installed, table empty
  var c: RzConfig = rz_config_default();
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_from_env(&c, &e) != 0) { return 1; }
  if (rz_config_port(&c) != 8080) { return 2; }
  if (rz_config_workers(&c) != 4) { return 3; }
  if (rz_config_max_body(&c) != 1048576) { return 4; }
  if (rz_config_error_count(&e) != 0) { return 5; }
  return 0;
}

// ---------------------------------------------------------------------------
// Rejected values: exact text, variable named
// ---------------------------------------------------------------------------

@test fn t_reject_port_not_a_number() -> int32 {
  rz_config_env_test_begin();
  rz_config_env_test_set("RAIZE_PORT", "notaport");
  var c: RzConfig = rz_config_default();
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_from_env(&c, &e) != -1) { return 1; }
  if (rz_config_port(&c) != 8080) { return 2; }          // never a silent bad value
  if (rz_config_error_count(&e) != 1) { return 3; }
  var text: string = rz_config_error_text(&e, 0);
  if (!rz_str_eq(text, "RAIZE_PORT: not a number or out of range: \"notaport\" (allowed 1..65535)")) { return 4; }
  if (!rz_str_contains(text, "RAIZE_PORT")) { return 5; }
  return 0;
}

@test fn t_reject_overflow() -> int32 {
  rz_config_env_test_begin();
  rz_config_env_test_set("RAIZE_PORT", "99999999999999999999");
  var c: RzConfig = rz_config_default();
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_from_env(&c, &e) != -1) { return 1; }
  if (rz_config_error_count(&e) != 1) { return 2; }
  var text: string = rz_config_error_text(&e, 0);
  if (!rz_str_eq(text, "RAIZE_PORT: not a number or out of range: \"99999999999999999999\" (allowed 1..65535)")) { return 3; }
  return 0;
}

@test fn t_alias_ignored() -> int32 {
  // RAISE_PORT (s instead of z) is not one of the twelve names. The overlay
  // never asks for it, so it is ignored like any unknown variable.
  rz_config_env_test_begin();
  rz_config_env_test_set("RAISE_PORT", "9999");
  var c: RzConfig = rz_config_default();
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_from_env(&c, &e) != 0) { return 1; }
  if (rz_config_port(&c) != 8080) { return 2; }
  if (rz_config_error_count(&e) != 0) { return 3; }

  // The API path names the misspelling instead of accepting it.
  if (rz_config_set_e(&c, "RAISE_PORT", "8080", &e) != RZ_CFG_E_UNKNOWN_KEY) { return 4; }
  var n: int32 = rz_config_error_count(&e);
  if (n != 1) { return 5; }
  if (!rz_str_eq(rz_config_error_text(&e, n - 1), "RAISE_PORT: unknown config variable")) { return 6; }
  return 0;
}

@test fn t_digits_only_set() -> int32 {
  var c: RzConfig = rz_config_default();
  if (rz_config_set(&c, "port", "+5") != RZ_CFG_E_PORT) { return 1; }
  if (rz_config_set(&c, "port", "5x") != RZ_CFG_E_PORT) { return 2; }
  if (rz_config_set(&c, "port", " 5") != RZ_CFG_E_PORT) { return 3; }
  if (rz_config_set(&c, "port", "") != RZ_CFG_E_PORT) { return 4; }
  if (rz_config_port(&c) != 8080) { return 5; }
  return 0;
}

// ---------------------------------------------------------------------------
// Validation
// ---------------------------------------------------------------------------

@test fn t_validate_workers_zero() -> int32 {
  var c: RzConfig = rz_config_default();
  c.workers = 0;
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_validate(&c, &e) != -1) { return 1; }
  if (rz_config_error_count(&e) != 1) { return 2; }
  if (!rz_str_eq(rz_config_error_text(&e, 0), "RAIZE_WORKERS: must be 1..64, got 0")) { return 3; }
  return 0;
}

@test fn t_validate_workers_65() -> int32 {
  var c: RzConfig = rz_config_default();
  c.workers = 65;
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_validate(&c, &e) != -1) { return 1; }
  if (!rz_str_eq(rz_config_error_text(&e, 0), "RAIZE_WORKERS: must be 1..64, got 65")) { return 2; }
  return 0;
}

@test fn t_validate_other_ranges() -> int32 {
  var c: RzConfig = rz_config_default();
  c.port = 70000;
  if (rz_config_validate_code(&c) != RZ_CFG_E_PORT) { return 1; }
  c = rz_config_default();
  c.max_body = 100;
  if (rz_config_validate_code(&c) != RZ_CFG_E_MAX_BODY) { return 2; }
  c = rz_config_default();
  c.max_body = 67108865;
  if (rz_config_validate_code(&c) != RZ_CFG_E_MAX_BODY) { return 3; }
  c = rz_config_default();
  c.max_header_bytes = 16384;
  if (rz_config_validate_code(&c) != RZ_CFG_E_MAX_HEADER) { return 4; }
  c = rz_config_default();
  c.keepalive_max = 0;
  if (rz_config_validate_code(&c) != RZ_CFG_E_KEEPALIVE) { return 5; }
  c = rz_config_default();
  c.read_timeout_ms = 0;
  if (rz_config_validate_code(&c) != RZ_CFG_E_TIMEOUT) { return 6; }
  c = rz_config_default();
  c.cache_max_age = -1;
  if (rz_config_validate_code(&c) != RZ_CFG_E_CACHE) { return 7; }
  return 0;
}

@test fn t_validate_roots() -> int32 {
  rz_config_dir_test_set(false);
  var c: RzConfig = rz_config_default();
  if (rz_config_validate_roots_code(&c) != RZ_CFG_E_STATIC_ROOT_MISSING) { return 1; }
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_validate_roots(&c, &e) != -1) { return 2; }
  if (rz_config_error_count(&e) != 2) { return 3; }   // both roots missing
  if (!rz_str_contains(rz_config_error_text(&e, 0), "RAIZE_STATIC_ROOT")) { return 4; }

  rz_config_dir_test_set(true);
  if (rz_config_validate_roots_code(&c) != RZ_CFG_OK) { return 5; }
  rz_config_dir_test_clear();
  return 0;
}

// ---------------------------------------------------------------------------
// Freeze
// ---------------------------------------------------------------------------

@test fn t_freeze_refuses_load() -> int32 {
  var c: RzConfig = rz_config_default();
  if (rz_config_freeze(&c) != 0) { return 1; }
  if (!rz_config_frozen(&c)) { return 2; }
  if (rz_config_freeze(&c) != 0) { return 3; }        // idempotent

  rz_config_env_test_begin();
  rz_config_env_test_set("RAIZE_PORT", "1234");
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_from_env(&c, &e) != RZ_CFG_E_FROZEN) { return 4; }
  if (rz_config_validate(&c, &e) != RZ_CFG_E_FROZEN) { return 5; }
  if (rz_config_set(&c, "port", "1234") != RZ_CFG_E_FROZEN) { return 6; }
  if (rz_config_load_defaults_env(&c, &e) != RZ_CFG_E_FROZEN) { return 7; }
  if (rz_config_port(&c) != 8080) { return 8; }       // nothing changed
  return 0;
}

// ---------------------------------------------------------------------------
// load_defaults_env and to_opts
// ---------------------------------------------------------------------------

@test fn t_load_defaults_env() -> int32 {
  rz_config_env_test_begin();
  rz_config_env_test_set("RAIZE_PORT", "1234");
  rz_config_env_test_set("RAIZE_WORKERS", "2");
  var c: RzConfig = rz_config_default();
  c.port = 9;          // proves the defaults step overwrites stale values
  c.workers = 9;
  var e: RzConfigErrors;
  t_errs(&e);
  if (rz_config_load_defaults_env(&c, &e) != 0) { return 1; }
  if (rz_config_port(&c) != 1234) { return 2; }
  if (rz_config_workers(&c) != 2) { return 3; }
  if (rz_config_max_body(&c) != 1048576) { return 4; }
  if (rz_config_frozen(&c)) { return 5; }             // freeze is explicit
  return 0;
}

@test fn t_to_opts_copies_every_field() -> int32 {
  var c: RzConfig = rz_config_default();
  rz_config_set(&c, "port", "1234");
  rz_config_set(&c, "workers", "2");
  rz_config_set(&c, "read_timeout_ms", "250");
  rz_config_set(&c, "keepalive_max", "7");

  var o: RzServerOpts = rz_server_opts_default();
  o.port = 1;
  o.workers = 1;
  o.read_timeout_ms = 1;
  o.keepalive_max = 1;
  o.buf_cap = 1;
  o.backlog = 1;
  if (rz_config_to_opts(&c, &o) != 0) { return 1; }
  if (o.port != 1234) { return 2; }
  if (o.workers != 2) { return 3; }
  if (o.read_timeout_ms != 250) { return 4; }
  if (o.keepalive_max != 7) { return 5; }
  if (o.buf_cap != 16384) { return 6; }
  if (o.backlog != 64) { return 7; }
  return 0;
}

// ---------------------------------------------------------------------------
// strerror
// ---------------------------------------------------------------------------

@test fn t_strerror_exact() -> int32 {
  if (!rz_str_eq(rz_config_strerror(RZ_CFG_E_PORT), "RAIZE_PORT: not a number or out of range (allowed 1..65535)")) { return 1; }
  if (!rz_str_eq(rz_config_strerror(RZ_CFG_E_WORKERS), "RAIZE_WORKERS: not a number or out of range (allowed 1..64)")) { return 2; }
  if (!rz_str_eq(rz_config_strerror(RZ_CFG_E_MAX_BODY), "RAIZE_MAX_BODY_BYTES: not a number or out of range (allowed 1024..67108864)")) { return 3; }
  if (!rz_str_eq(rz_config_strerror(RZ_CFG_E_FROZEN), "config: frozen after startup; load/set/validate refused")) { return 4; }
  if (!rz_str_contains(rz_config_strerror(999), "unknown")) { return 5; }
  return 0;
}
