// tests/fixtures/server — the server layer's own harness.
//
// No router, no middleware: a hand-written `fn(RzContext*) -> int32` on top of
// framework/server + framework/context only. This is the "hand-written 200 and
// 404" half of the server hand-off, and the target for caps.py (keep-alive
// budget, 408, big bodies, 100-continue, byte-at-a-time reads, pipelining,
// HEAD, header count).
//
// Build and run from the repo root:
//   ./mettle-build/bin/mettle --build tests/fixtures/server/app.mettle -o build/server_fixture
//   ./build/server_fixture            # 127.0.0.1:8099
//   python3 tests/fixtures/server/caps.py 8099

import "std/io";
import "std/mem";
import "../../../framework/str/str";
import "../../../framework/context/context";
import "../../../framework/server/server";

fn h_root(ctx: RzContext*) -> int32 {
  return rz_ctx_text(ctx, 200, "hello from fixture\n");
}

fn h_incremental(ctx: RzContext*) -> int32 {
  return rz_ctx_text(ctx, 200, "incremental ok\n");
}

// POST /echo — proves the body arrived intact, whatever its size.
fn h_echo(ctx: RzContext*) -> int32 {
  if (ctx->req->body_len > 0) {
    rz_resp_set_content_type(ctx->resp, "application/octet-stream");
    ctx->resp->status = 200;
    rz_resp_set_body(ctx->resp, ctx->req->body);
    ctx->status = 200;
    return 0;
  }
  return rz_ctx_text(ctx, 200, "");
}

// GET /json — the read-only JSON accessors, in both directions.
fn h_json(ctx: RzContext*) -> int32 {
  var b: RaizeBuf* = raize_buf_new_cap(128);
  if (b == 0) { return rz_ctx_text(ctx, 500, "oom\n"); }
  var n: int64 = 0;
  if (rz_json_get_int(ctx->req->body, "n", &n)) {
    raize_buf_add(b, "{{\"n\":");
    raize_buf_add_int(b, n * 2);
    raize_buf_add(b, "}");
  } else {
    raize_buf_add(b, "{{\"n\":null}");
  }
  var body: string = raize_buf_str(b);
  var rc: int32 = rz_ctx_json(ctx, 200, body);
  raize_buf_free(b);
  return rc;
}

fn h_method(ctx: RzContext*) -> int32 {
  return rz_ctx_text(ctx, 405, "method not allowed\n");
}

fn handle(ctx: RzContext*) -> int32 {
  var req: RzRequest* = ctx->req;
  if (rz_req_is_post(req)) {
    if (raize_str_eq(req->path, "/echo")) { return h_echo(ctx); }
    if (raize_str_eq(req->path, "/")) { return h_method(ctx); }
    return rz_ctx_not_found(ctx);
  }
  if (rz_req_is_get(req) || rz_req_is_head(req)) {
    if (raize_str_eq(req->path, "/")) { return h_root(ctx); }
    if (raize_str_eq(req->path, "/incremental")) { return h_incremental(ctx); }
    if (raize_str_eq(req->path, "/json")) { return h_json(ctx); }
  }
  return rz_ctx_not_found(ctx);
}

fn main() -> int32 {
  var opts: RzServerOpts = rz_server_opts_default();
  opts.port = 8099;
  opts.read_timeout_ms = 5000;
  var srv: RzServer* = rz_server_new(opts);
  if (srv == 0) {
    println("fixture: rz_server_new failed");
    return 1;
  }
  if (rz_server_set_handler(srv, &handle) != 0) {
    println("fixture: set_handler failed");
    rz_server_free(srv);
    return 2;
  }
  println("fixture: listening on 127.0.0.1:{opts.port}");
  var rc: int32 = rz_server_run(srv);
  rz_server_free(srv);
  return rc;
}
