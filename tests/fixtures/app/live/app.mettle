// tests/fixtures/app/live — per-user Signals (P3-C2, DECISIONS A9, A10, F5): a guarded
// Signal whose 2-arg mount reads the guard's user and the cookie, and a public Signal
// with the 1-arg mount. Driven by test.sh and client.py; default port 8072.
//
//   GET /admin    guard: no known sid cookie -> 302 /login; else ctx->user is set.
//                 Signal board: shows the user and their own counter (ann starts at
//                 10, bob at 20); mount refuses eve (RZ_E_NOT_FOUND -> 404 / join
//                 refused {"reason":"not found"}).
//   GET /public   Signal hits, 1-arg mount (starts at 5), no guard.
//   GET /login    plain text.
// Sockets: /signal/websocket?path=<page> runs that page's guards and may join only
// the Signal mounted there.

import "raize";

struct LiveUser { name: string; start: int32; banned: bool; }

// Set by live_app before the server runs, read-only afterwards.
var g_ann: LiveUser;
var g_bob: LiveUser;
var g_eve: LiveUser;

fn live_user_for(sid: string) -> LiveUser* {
  if (rz_str_eq(sid, "ann-token")) { return &g_ann; }
  if (rz_str_eq(sid, "bob-token")) { return &g_bob; }
  if (rz_str_eq(sid, "eve-token")) { return &g_eve; }
  return 0;
}

// Runs for GET /admin and for a Signal socket opened with path=/admin.
fn live_guard(ctx: RzContext*) -> int32 {
  var u: LiveUser* = live_user_for(rz_ctx_cookie(ctx, "sid"));
  if (u == 0) { return rz_ctx_redirect(ctx, 302, "/login"); }
  rz_ctx_set_user(ctx, (rawptr)u);
  return RZ_OK;
}

@signal
struct Board { who: string; sid: string; path: string; n: int32; }
enum BoardMsg { Inc, Set(int32) }

fn board_mount(s: Board*, c: RzConn*) -> int32 {
  var u: LiveUser* = (LiveUser*)rz_conn_user(c);
  if (u == 0) { return RZ_E_USAGE; }
  if (u->banned) { return RZ_E_NOT_FOUND; }
  s->who = u->name;
  s->sid = rz_str_dup(rz_conn_cookie(c, "sid"));
  s->path = rz_str_dup(rz_conn_path(c));
  s->n = u->start;
  return RZ_OK;
}
fn board_update(s: Board*, msg: BoardMsg) {
  match (msg) { case Inc: { s->n = s->n + 1; } case Set(v): { s->n = v; } }
}
fn board_view(s: Board*) -> RzHtml* {
  return html"""<p class="who">{s->who}</p><p class="sid">{s->sid}</p><p class="path">{s->path}</p><p class="n">{s->n}</p><button on:click={Inc}>+</button>""";
}
fn board_leave(s: Board*) {
  rz_str_free(s->sid);
  rz_str_free(s->path);
}

@signal
struct Hits { n: int32; }
enum HitsMsg { Hit, Reset(int32) }
fn hits_mount(s: Hits*) { s->n = 5; }
fn hits_update(s: Hits*, msg: HitsMsg) {
  match (msg) { case Hit: { s->n = s->n + 1; } case Reset(v): { s->n = v; } }
}
fn hits_view(s: Hits*) -> RzHtml* {
  return html"""<p class="hits">{s->n}</p>""";
}

fn live_login(ctx: RzContext*) -> int32 { return rz_ctx_text(ctx, 200, "sign in\n"); }

fn live_app(app: RzApp*) {
  g_ann.name = "ann";
  g_ann.start = 10;
  g_bob.name = "bob";
  g_bob.start = 20;
  g_eve.name = "eve";
  g_eve.banned = true;
  rz_default(app, "port", "8072");
  rz_guard(app, "/admin", &live_guard);
  board_signal(app, "/admin", "");
  hits_signal(app, "/public", "");
  rz_get(app, "/login", &live_login);
}

fn main() -> int32 { return rz_run("live", &live_app); }
