# Package roots. mbuild maintains the block below; the Makefile build reads it too.
# >>> mbuild: generated, edits inside this block are overwritten
raize_core=./libs/core
raize_realtime=./libs/realtime
raize_signal=./libs/signal
raize_resource=./libs/resource
raize=.
# <<< mbuild
# Outside the mbuild block (the umbrella does not depend on them): raize_session and
# what it builds on, for apps that opt in to sessions.
raize_session=./libs/session
session=../session/src
crypto=../cryptex/src
