import "mbuild/api";

// raize_core: raize core: strings, status, request context, router, HTTP server, poll loop, middleware, config, static files, templates
// Part of raize (https://github.com/Lex-Dellimere/RaizeWeb). Library only, no bins.
fn project() {
  mb_package("raize_core", "0.1.0");
  mb_meta("description", "raize core: strings, status, request context, router, HTTP server, poll loop, middleware, config, static files, templates");
  mb_meta("license", "Apache-2.0");
}

// Sibling packages by path until raize is published; publish switches these to mb_dep.
fn deps() {
}
