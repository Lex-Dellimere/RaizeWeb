import "mbuild/api";

// raize_app: raize app layer: rz_run, declarations (routes, Signals, resources, channels, guards), rz_use, rz_every
// Part of raize (https://github.com/Lex-Dellimere/RaizeWeb). Library only, no bins.
fn project() {
  mb_package("raize_app", "0.1.0");
  mb_meta("description", "raize app layer: rz_run, declarations (routes, Signals, resources, channels, guards), rz_use, rz_every");
  mb_meta("license", "Apache-2.0");
}

// Sibling packages by path until raize is published; publish switches these to mb_dep.
fn deps() {
  mb_dep_path("raize_core", "../core");
  mb_dep_path("raize_realtime", "../realtime");
  mb_dep_path("raize_signal", "../signal");
  mb_dep_path("raize_resource", "../resource");
}
