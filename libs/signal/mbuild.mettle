import "mbuild/api";

// raize_signal: raize Signals: server-rendered real-time views (html literals, diff render, signal.js client)
// Part of raize (https://github.com/Lex-Dellimere/RaizeWeb). Library only, no bins.
fn project() {
  mb_package("raize_signal", "0.1.0");
  mb_meta("description", "raize Signals: server-rendered real-time views (html literals, diff render, signal.js client)");
  mb_meta("license", "Apache-2.0");
}

// Sibling packages by path until raize is published; publish switches these to mb_dep.
fn deps() {
  mb_dep_path("raize_core", "../core");
  mb_dep_path("raize_realtime", "../realtime");
}
