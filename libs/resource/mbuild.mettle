import "mbuild/api";

// raize_resource: raize Resources: declared attributes and actions, typed code interface, JSON API, memory data layer
// Part of raize (https://github.com/Lex-Dellimere/RaizeWeb). Library only, no bins.
fn project() {
  mb_package("raize_resource", "0.1.0");
  mb_meta("description", "raize Resources: declared attributes and actions, typed code interface, JSON API, memory data layer");
  mb_meta("license", "Apache-2.0");
}

// Sibling packages by path until raize is published; publish switches these to mb_dep.
fn deps() {
  mb_dep_path("raize_core", "../core");
}
