import "mbuild/api";

// raize_realtime: raize realtime: WebSocket, hub thread, Phoenix v2 channels
// Part of raize (https://github.com/Lex-Dellimere/RaizeWeb). Library only, no bins.
fn project() {
  mb_package("raize_realtime", "0.1.0");
  mb_meta("description", "raize realtime: WebSocket, hub thread, Phoenix v2 channels");
  mb_meta("license", "Apache-2.0");
}

// Sibling packages by path until raize is published; publish switches these to mb_dep.
fn deps() {
  mb_dep_path("raize_core", "../core");
}
